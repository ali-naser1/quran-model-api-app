# Copy to .env and fill in. .env is never committed.

# Clients must send this in the X-API-Key header (leave empty to disable auth).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Streamlit test client: where the API runs (docker-compose sets this itself).
API_URL=http://127.0.0.1:8000

# Docker only:
# TORCH=cpu            # cu128 on a GPU server (with docker-compose.gpu.yml)
# API_BIND=127.0.0.1   # 0.0.0.0 exposes the API publicly; keep API_KEY set if you do
