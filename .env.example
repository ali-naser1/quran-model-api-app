# Copy to .env and fill in. .env is never committed.

# Server only: domain whose DNS A record points at the server (needed for HTTPS / microphone).
DOMAIN=quran.example.com

# Optional: Azure Speech (cloud model in the Transcribe tab).
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=https://uaenorth.api.cognitive.microsoft.com

# Optional overrides (defaults shown).
# PRELOAD_MODELS=Whisper Base (Quran),Muaalem (tajweed)
# ALLOW_MODEL_CONTROL=false
